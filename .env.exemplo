# Copie para .env (nunca versione o .env) ou cadastre como variaveis na hospedagem.
DJANGO_SECRET_KEY=gere-com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=seu-dominio.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-dominio.up.railway.app
DATABASE_URL=postgres://usuario:senha@host:5432/carteira
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=troque-por-uma-senha-forte
DJANGO_SUPERUSER_EMAIL=voce@exemplo.com
